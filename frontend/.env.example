# Copy this file to .env.local for local development and set real values.
# On the hosting platform (Vercel, etc.), set these as environment variables
# for the production/preview deployments instead of committing a .env file.

# Public site URL used to build absolute URLs (canonical, OpenGraph, JSON-LD).
NEXT_PUBLIC_SITE_URL=https://maadinemarrakech.com

# Google Analytics 4 Measurement ID. When unset, GA4 tracking scripts are
# skipped entirely (see app/[locale]/layout.tsx).
NEXT_PUBLIC_GA_ID=G-ET37TY874G
